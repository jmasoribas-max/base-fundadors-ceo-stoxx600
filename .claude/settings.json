{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(*git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *protection*)",
      "Edit(/scripts/**)",
      "Edit(/docs/METODOLOGIA.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/REGLES*)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)"
    ]
  }
}
